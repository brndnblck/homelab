[Unit]
Description=Homebridge
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/podman run --pull=missing --replace --rm --name %n \
  --network host \
  --cgroups=split \
  --read-only-tmpfs \
  --security-opt no-new-privileges \
  --health-cmd="curl -f http://localhost:8581 || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -v /var/services/homebridge:/homebridge:z \
  docker.io/homebridge/homebridge:latest

[Install]
WantedBy=multi-user.target

