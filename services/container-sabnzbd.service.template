[Unit]
Description=SABnzbd
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
Delegate=yes
ExecStop=/usr/bin/podman stop --ignore --time 25 %n
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardError=journal
StandardOutput=journal
EnvironmentFile=/etc/homelab/storage.env
ExecStartPre=/usr/bin/python3 /var/scripts/configure-sab.py
ExecStart=/usr/bin/podman run --pull=missing --replace --rm --name %n --cgroups=split \
  --network internal-net \
  --read-only-tmpfs \
  --security-opt no-new-privileges \
  --health-cmd="curl -f http://localhost:8085 || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -e PUID=911 -e PGID=911 \
  -p 8085:8085 \
  -v /var/services/sabnzbd:/config:z \
  -v /var/downloads:/downloads:z \
  lscr.io/linuxserver/sabnzbd:latest

[Install]
WantedBy=multi-user.target
