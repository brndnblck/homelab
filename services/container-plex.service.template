[Unit]
Description=Plex
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
RequiresMountsFor=/var/mnt/tv /var/mnt/movies /var/mnt/music
BindsTo=var-mnt-tv.mount var-mnt-movies.mount var-mnt-music.mount
After=var-mnt-tv.mount var-mnt-movies.mount var-mnt-music.mount
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/sh /var/scripts/check-shares.sh tv movies music
ExecStart=/usr/bin/podman run --pull=missing -h Black --replace --rm --name %n \
  --network host \
  --cgroups=split \
  --health-cmd="curl -f http://localhost:32400/web || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -e PLEX_UID=1000 -e PLEX_GID=1000 \
  -e PLEX_CLAIM={{PLEX_CLAIM}} \
  -v /var/services/plex/config:/config:z \
  -v /var/downloads/transcode:/transcode:z \
  -v /mnt/tv:/data/TV \
  -v /mnt/music:/data/Music \
  -v /mnt/movies:/data/Movies \
  docker.io/plexinc/pms-docker

[Install]
WantedBy=multi-user.target
