[Unit]
Description=Lidarr
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
RequiresMountsFor=/var/mnt/music
BindsTo=var-mnt-music.mount
After=var-mnt-music.mount
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
Delegate=yes
ExecStop=/usr/bin/podman stop --ignore --time 25 %n
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/sh /var/scripts/check-shares.sh music
ExecStart=/usr/bin/podman run --pull=missing --replace --rm --name %n --cgroups=split \
  --network internal-net \
  --health-cmd="curl -f http://localhost:8686 || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -e PUID=911 -e PGID=911 \
  -p 8082:8686 \
  -v /var/services/lidarr:/config:z \
  -v /var/downloads:/downloads:z \
  -v /mnt/music:/music \
  lscr.io/linuxserver/lidarr:latest

[Install]
WantedBy=multi-user.target
