[Unit]
Description=Radarr
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
RequiresMountsFor=/var/mnt/movies
BindsTo=var-mnt-movies.mount
After=var-mnt-movies.mount
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/sh /var/scripts/check-shares.sh movies
ExecStart=/usr/bin/podman run --pull=missing --replace --rm --name %n --cgroups=split \
  --network internal-net \
  --health-cmd="curl -f http://localhost:7878 || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -e PUID=911 -e PGID=911 \
  -p 8083:7878 \
  -v /var/services/radarr:/config:z \
  -v /var/downloads:/downloads:z \
  -v /mnt/movies:/movies \
  lscr.io/linuxserver/radarr:latest

[Install]
WantedBy=multi-user.target
