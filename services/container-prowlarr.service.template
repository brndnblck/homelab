[Unit]
Description=Prowlarr
After=podman.service task-shared.service task-networks.service
Requires=podman.service task-shared.service task-networks.service
StartLimitBurst=3
StartLimitIntervalSec=300s

[Service]
Delegate=yes
ExecStop=/usr/bin/podman stop --ignore --time 25 %n
TimeoutStopSec=30
TimeoutStartSec=120
Type=simple
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/podman run --pull=missing --replace --rm --name %n --cgroups=split \
  --network internal-net \
  --read-only-tmpfs \
  --security-opt no-new-privileges \
  --health-cmd="curl -f http://localhost:9696 || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=3 \
  --health-start-period=120s \
  -e TZ=America/Los_Angeles \
  -e PUID=911 -e PGID=911 \
  -p 8084:9696 \
  -v /var/services/prowlarr:/config:z \
  lscr.io/linuxserver/prowlarr:latest

[Install]
WantedBy=multi-user.target
